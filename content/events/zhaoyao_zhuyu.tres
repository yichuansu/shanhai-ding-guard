[resource]
script = ExtResource("3_7uoam")
id = &"zhaoyao_zhuyu"
title = "招摇祝余"
source_text = "南山经之首曰䧿山。其首曰招摇之山……有草焉，其状如韭而青华，其名曰祝余，食之不饥。"
situation = "招摇山坡上长满青花如韭的草。"
options = Array[ExtResource("1_txmiw")]([SubResource("Resource_cckdq"), SubResource("Resource_5gf5s")])
