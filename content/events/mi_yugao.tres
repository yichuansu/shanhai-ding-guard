[resource]
script = ExtResource("3_0ylr0")
id = &"mi_yugao"
title = "峚山玉膏"
source_text = "西北四百二十里，曰峚山……其中多白玉，是有玉膏，其原沸沸汤汤，黄帝是食是飨。"
situation = "山涧里白玉如脂，玉膏正汩汩涌出。"
