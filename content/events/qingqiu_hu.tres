[resource]
script = ExtResource("3_t0xhy")
id = &"qingqiu_hu"
title = "青丘之狐"
source_text = "又东三百里，曰青丘之山……有兽焉，其状如狐而九尾，其音如婴儿，能食人；食者不蛊。"
situation = "夜宿青丘，林间传来婴儿般的啼声，九条尾影在月下晃动。"
options = Array[ExtResource("1_x31tl")]([SubResource("Resource_8gy8f"), SubResource("Resource_p3ol2"), SubResource("Resource_chut8")])
