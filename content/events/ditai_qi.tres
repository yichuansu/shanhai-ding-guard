[resource]
script = ExtResource("3_a8ili")
id = &"ditai_qi"
title = "帝台之棋"
source_text = "休与之山，其上有石焉，名曰帝台之棋，五色而文，其状如鹑卵。帝台之石，所以祷百神者也，服之不蛊。"
situation = "山顶散落着五色斑斓、状如鹌鹑蛋的石子。"
options = Array[ExtResource("1_qv7hp")]([SubResource("Resource_yg8h1"), SubResource("Resource_tx720")])
