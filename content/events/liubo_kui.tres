[sub_resource type="Resource" id="Resource_egq8f"]
script = ExtResource("1_ylonx")
label = "远远观望"
hint = "贝币 +6"
outcomes = Array[ExtResource("2_mk6w7")]([SubResource("Resource_m4ouu")])
success_text = "风雨过后，沙滩上留下几枚贝币。"

[resource]
script = ExtResource("3_713hv")
id = &"liubo_kui"
title = "流波山之夔"
source_text = "东海中有流波山，入海七千里。其上有兽，状如牛，苍身而无角，一足，出入水则必风雨，其光如日月，其声如雷，其名曰夔。"
situation = "海上风雨大作，雷声中一头独足苍牛踏浪而来。"
options = Array[ExtResource("1_ylonx")]([SubResource("Resource_n7iuw"), SubResource("Resource_egq8f")])
