[sub_resource type="Resource" id="Resource_n7iuw"]
script = ExtResource("1_ylonx")
label = "以鼎为鼓，与之相搏"
hint = "铜鼎耐久 -4，夔加入阵容（阵容满则离去）"
outcomes = Array[ExtResource("2_mk6w7")]([SubResource("Resource_lhktl"), SubResource("Resource_7wwgt")])
success_text = "鼎声与雷声相应，夔低下了头。"

[sub_resource type="Resource" id="Resource_m4ouu"]
